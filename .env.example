# ──────────────────────────────────────────────────────────────────────────
# Discord Music Bot — environment configuration
# Copy this file to ".env" and fill in the values. NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application (client) ID from the same app -> General Information
CLIENT_ID=
# Optional: a guild (server) ID to register slash commands INSTANTLY during dev.
# Leave blank to register commands globally (can take up to ~1h to appear).
DEV_GUILD_ID=
# Optional: your own Discord user ID (for owner-only conveniences / logs).
OWNER_ID=

# ── Lavalink (required — must match lavalink/application.yml) ─────────────
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
# true only if Lavalink is behind TLS (not needed for localhost on the same host)
LAVALINK_SECURE=false

# ── Spotify (required — needed to resolve Spotify links) ──────────────────
# Create an app at https://developer.spotify.com/dashboard -> Client ID / Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Bot behaviour (optional — sensible defaults applied) ──────────────────
# Default volume for new players (0-100)
DEFAULT_VOLUME=80
# Default search platform: ytmsearch (YouTube Music) | ytsearch | scsearch
DEFAULT_SEARCH_PLATFORM=ytmsearch
# Idle timeout (ms) before the bot auto-leaves an empty/idle voice channel (default 5 min)
IDLE_TIMEOUT_MS=300000
# Leave the voice channel when everyone else leaves
AUTO_LEAVE_ON_EMPTY=true
# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── Optional reliability upgrades (leave blank to keep disabled) ──────────
# These are wired in lavalink/application.yml but commented out by default.
YT_OAUTH_REFRESH_TOKEN=
YT_PO_TOKEN=
YT_VISITOR_DATA=
YT_CIPHER_PASSWORD=
DEEZER_ARL=
DEEZER_MASTER_KEY=
